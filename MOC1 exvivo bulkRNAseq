# 1. PROCESS YOUR GSEA DATAFRAME
plot_df <- gsea_df %>%
  # Filter for activated (upregulated) pathways that are statistically significant
  filter(NES > 0, p.adjust < 0.05) %>%
  
  # Optional: Keep only the top 12 to prevent the plot from getting too crowded
  slice_max(order_by = NES, n = 12) %>%
  
  # Clean up MSigDB Pathway names 
  # (e.g., turns "HALLMARK_INFLAMMATORY_RESPONSE" into "Inflammatory Response")
  mutate(Pathway = str_remove(ID, "^HALLMARK_")) %>%
  mutate(Pathway = str_replace_all(Pathway, "_", " ")) %>%
  mutate(Pathway = str_to_upper(Pathway)) %>%
  
  # Map clusterProfiler column names to our plotting variables
  rename(
    Fold_Enrichment = NES,
    FDR = p.adjust,
    Gene_Count = setSize
  ) %>%
  
  # Calculate -log10(FDR) for the color gradient
  mutate(minus_log10_FDR = -log10(FDR)) %>%
  
  # Sort by Fold Enrichment (NES) to create the upward staggered effect
  arrange(Fold_Enrichment) %>%
  
  # Create a Y-rank to space the points out vertically
  mutate(Y_Rank = row_number()) %>%
  
  # Wrap long pathway names so they fit nicely on the plot
  mutate(Pathway_Wrapped = str_wrap(Pathway, width = 20))

# 2. CREATE THE PLOT
p <- ggplot(plot_df, aes(x = Fold_Enrichment, y = Y_Rank)) +
  
  # Add the bubbles
  geom_point(aes(size = Gene_Count, color = minus_log10_FDR), alpha = 0.9) +
  
  # Add the labels with connector lines
  geom_text_repel(
    aes(label = Pathway_Wrapped),
    size = 3.5,
    fontface = "bold",
    box.padding = 0.8,
    point.padding = 0.5,
    min.segment.length = 0, # Forces the line to always draw
    segment.color = "black",
    segment.size = 0.5
  ) +
  
  # 3. SCALES & LEGENDS
  # Set the color gradient (OrRd reversed)
  scale_color_gradient(
    low = "blue", 
    high = "#EB5C37", 
    name = expression(bold(paste("-Log"["10"], " FDR")))
  ) +
  
  # Dynamically set bubble size breaks based on your actual gene counts
  scale_size_continuous(
    range = c(4, 12), 
    name = "# genes / set"
  ) +
  
  # 4. AESTHETICS & THEMES
  labs(x = "Normalized Enrichment Score (NES)", y = NULL) +
  theme_classic() +
  theme(
    # Make axis titles bold and larger
    axis.title.x = element_text(face = "bold", size = 14),
    axis.text.x = element_text(size = 12),
    
    # Remove Y-axis ticks and text (since Y is just a pseudo-rank)
    axis.line.y = element_blank(),
    axis.text.y = element_blank(),
    axis.ticks.y = element_blank(),
    
    # Add a border around the entire plot
    panel.border = element_rect(colour = "black", fill = NA, linewidth = 1),
    
    # Adjust legend styling
    legend.title = element_text(face = "bold", size = 10),
    legend.position = "right"
  ) +
  # Force the size legend to be black points instead of taking the color gradient
  guides(
    color = guide_colorbar(barheight = 4, barwidth = 1, order = 1),
    size = guide_legend(override.aes = list(color = "black"), order = 2)
  )

# Display the plot
print(p)
