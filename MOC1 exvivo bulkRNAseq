# This pulls the IDs from your clusterProfiler results object
pathways_to_plot <- gsea_results@result$ID

# 3. Loop through every single pathway and generate the plot
for (pathway_name in pathways_to_plot) {
  nes_val <- round(gsea_results@result[pathway_name, "NES"], 2)
  q_val   <- signif(gsea_results@result[pathway_name, "p.adjust"], 3)
  # Create the custom text string
  custom_text <- paste0("NES = ", nes_val, "\nq-value = ", q_val)
  # Generate the plot using gseaplot2
  # The magic here is 'pvalue_table = TRUE', which prints the NES and q-value directly on the plot!
  p <- gseaplot2(gsea_results, 
                 geneSetID = 1, 
                 title = pathway_name, 
                 pvalue_table = FALSE) 
  p[[1]] <- p[[1]] + 
    annotate("text", 
             x = Inf, y = Inf,      # This anchors the text to the absolute top-right corner
             label = custom_text, 
             hjust = 1.1,           # Pushes it slightly left from the right edge
