# Pull all 50 Hallmark gene sets for mouse
mouse_msigdb <- msigdbr(species = "Mus musculus", category = "H") %>% 
  dplyr::select(gs_name, gene_symbol)



# Create the specific 2-column dataframe clusterProfiler requires
term2gene <- mouse_msigdb[, c("gs_name", "gene_symbol")]



# Run the GSEA
set.seed(42) # Ensures the random noise is the same every time you run it
gene_list_4v1 <- gene_list_4v1 + runif(length(gene_list_4v1), min = -1e-6, max = 1e-6)

# 2. Re-sort the list just to be absolutely certain it is in perfect descending order
gene_list_4v1 <- sort(gene_list_4v1, decreasing = TRUE)

# 3. Run the GSEA function using a single core (SerialParam) to prevent the crash
gsea_results <- GSEA(geneList     = gene_list_4v1, 
                     TERM2GENE    = term2gene,
                     minGSSize    = 10,               # Exclude pathways with < 10 genes
                     maxGSSize    = 500,              # Exclude pathways with > 500 genes
                     pvalueCutoff = 0.05,
                     BPPARAM      = SerialParam()) # This line fixes the serialize error

gsea_df <- as.data.frame(gsea_results)

# 2. Filter and select the exact columns requested
hallmark_table <- gsea_df %>%
  # Keep only Hallmark pathways
  filter(str_detect(ID, "^HALLMARK_")) %>%
  
  # Filter for statistical significance (FDR < 0.05 is standard, adjust if needed)
  filter(p.adjust < 0.05) %>%
  
  # Determine if the pathway is Activated or Suppressed
  mutate(Status = ifelse(NES > 0, "Activated", "Suppressed")) %>%
  
  # Select and rename the specific columns for clarity
  dplyr::select(
    Pathway = ID, 
    NES = NES, 
    FDR_p_adjust = p.adjust, 
    Status = Status
  ) %>%
  
  # Sort by the strength of the NES score
  arrange(desc(NES))

# Display the table in your R console
print(hallmark_table)

